# ---------------------------------------------------------------------------
# JobMatch configuration. Copy to `.env` and fill in what you need.
# Everything here is optional — the app runs with no .env at all, using
# SQLite, rule-based resume parsing and the four keyless public job feeds.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Required in production: without it, tokens are signed with a key that is
# regenerated on restart, so sessions break across restarts and replicas.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database --------------------------------------------------------------
# Postgres is the production target. Leave blank to use a local SQLite file
# at backend/var/jobmatch.db.
# DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch

# --- Frontend / CORS -------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins, if you serve the UI from more than one host.
EXTRA_CORS_ORIGINS=

# --- AI --------------------------------------------------------------------
# With a key: an LLM structures resumes and writes match explanations.
# Without:    rule-based parsing and templated explanations are used instead,
#             and the UI says so. Match percentages are identical either way —
#             the LLM never produces the score.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Semantic similarity. If `sentence-transformers` is installed, this model is
# downloaded on first use. Otherwise a hashed TF-IDF fallback is used, which
# needs no network and still discriminates, just less sharply.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_SENTENCE_TRANSFORMERS=true

# --- Job sources -----------------------------------------------------------
# Always on, no credentials needed:
#   Remotive, Arbeitnow, Jobicy, RemoteOK
#
# Adzuna — free developer tier at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch (RapidAPI) — a licensed aggregator that indexes Google Jobs,
# LinkedIn and Indeed. One key enables all three of those sources.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com

# Naukri, Glassdoor, Wellfound and Internshala have no lawful public search
# API for this use case and are therefore listed in the UI as unavailable.
# There is no key that enables them here, and nothing is scraped.

# --- Discovery tuning ------------------------------------------------------
SOURCE_TIMEOUT_SECONDS=30
SOURCE_CONCURRENCY=4
MAX_JOBS_PER_SOURCE_PER_QUERY=50

# --- Background work -------------------------------------------------------
# Blank uses an in-process thread pool. Set a Redis URL to dispatch through
# Celery instead; call sites are unchanged.
REDIS_URL=
TASK_WORKER_THREADS=4

# --- Uploads & limits ------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
AUTH_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# --- Frontend --------------------------------------------------------------
# Read by Next.js at build and run time.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
